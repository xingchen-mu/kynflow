{
  "name": "kynflow",
  "private": true,
  "version": "0.2.0",
  "main": "desktop/main.mjs",
  "desktopName": "Kynflow",
  "description": "Kynflow: an agent-driven infinite canvas for ComfyUI. Generate, edit and animate images on a board, with every result linked to its inputs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchen-mu/kynflow.git"
  },
  "homepage": "https://xingchen-mu.github.io/kynflow/",
  "bugs": {
    "url": "https://github.com/xingchen-mu/kynflow/issues"
  },
  "author": {
    "name": "Kynflow contributors",
    "email": "xingchen-mu@users.noreply.github.com"
  },
  "license": "MIT",
  "keywords": [
    "comfyui",
    "infinite-canvas",
    "ai-image",
    "image-generation",
    "video-generation",
    "workflow",
    "stable-diffusion",
    "ai-agent",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n tunnel,server,web -c gray,cyan,magenta \"node scripts/tunnel.mjs\" \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "dev:noTunnel": "concurrently -k -n server,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "tsc --noEmit && vite build",
    "build:demo": "node scripts/build-demo.mjs",
    "export:demo": "tsx scripts/export-demo.mjs",
    "demo:rebuild": "tsx scripts/rebuild-demo-commercial.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "desktop:dev": "npm run build && node scripts/ensure-electron.mjs && node scripts/run-electron.mjs desktop/main.mjs",
    "desktop:dir": "npm run build && node scripts/ensure-electron.mjs && electron-builder --dir",
    "desktop:dist": "npm run build && node scripts/ensure-electron.mjs && electron-builder",
    "site:build": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:wf": "tsx scripts/test-workflow.ts",
    "build:presets": "tsx scripts/build-presets.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.13.19",
    "image-size": "^2.1.0",
    "lucide-react": "^1.75.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.kynflow.app",
    "productName": "Kynflow",
    "asar": true,
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "presets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tsx/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
